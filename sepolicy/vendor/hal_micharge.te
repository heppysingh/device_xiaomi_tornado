type hal_micharge_default, domain;
type hal_micharge_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_micharge_default)

add_hwservice(hal_micharge_default, hal_micharge_hwservice)
allow hal_micharge_default hidl_base_hwservice:hwservice_manager add;

allow hal_micharge_default block_device:dir search;
allow hal_micharge_default sysfs:dir r_dir_perms;
allow hal_micharge_default sysfs:file rw_file_perms;
allow hal_micharge_default sysfs_batteryinfo:dir r_dir_perms;
allow hal_micharge_default sysfs_batteryinfo:file rw_file_perms;
allow hal_micharge_default hwservicemanager:binder { call transfer };
allow hal_micharge_default system_server:binder { call transfer };
